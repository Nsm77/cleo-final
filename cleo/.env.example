DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# 32+ random bytes. REQUIRED in production — the app refuses to boot without it.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated subset of: cod,bank_transfer,card,gift_card
# Defaults to "cod,bank_transfer,gift_card". `card` stays out until a real
# payment integration exists — the server rejects it regardless of this list.
# PAYMENT_METHODS_ENABLED=cod,bank_transfer,gift_card

# Seed script only (npm run db:seed). Defaults shown are development-only;
# they are refused when NODE_ENV=production.
# SEED_ADMIN_PASSWORD=
# SEED_SUPPORT_PASSWORD=
# SEED_CLIENT_PASSWORD=

# Escape hatch for `npm run db:seed` against a production database.
# The seed TRUNCATEs every table; without this it aborts when NODE_ENV=production.
# ALLOW_DESTRUCTIVE_SEED=1
